{% assign repo_entry = include.repository %}
{% assign repo_slug = repo_entry.slug | default: repo_entry %}
{% assign repo_parts = repo_slug | split: '/' %}
{% assign repo_owner = repo_entry.owner | default: repo_parts[0] %}
{% assign repo_name = repo_entry.title | default: repo_entry.name | default: repo_parts[1] %}

<article class="repo-card" data-repo="{{ repo_slug }}">
  <header class="repo-card__header">
    <a class="repo-card__name" href="https://github.com/{{ repo_slug }}" target="_blank" rel="noopener noreferrer">
      <svg class="repo-card__icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h7A2.5 2.5 0 0 1 14 2.5v11a.5.5 0 0 1-.777.416L8 10.101l-5.223 3.815A.5.5 0 0 1 2 13.5z" />
      </svg>
      <span><span class="repo-card__owner">{{ repo_owner }}</span>/<strong>{{ repo_name }}</strong></span>
    </a>
    <span class="repo-card__language" hidden>
      <span class="repo-card__language-dot" aria-hidden="true"></span>
      <span class="repo-card__language-text"></span>
    </span>
  </header>

  <p class="repo-card__description">
    Loading...
  </p>

  <footer class="repo-card__meta">
    <span class="repo-card__stat" aria-label="Stars">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 .25l1.898 5.842h6.102l-4.95 3.598 1.898 5.842L8 11.934l-4.948 3.598 1.898-5.842L0 6.092h6.102z" />
      </svg>
      <span class="repo-card__stars">0</span>
    </span>
    <span class="repo-card__stat" aria-label="Forks">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M5 3.25a2.25 2.25 0 1 1-3 2.122v5.256a2.25 2.25 0 1 1 1.5 0v-3.72l4-2.285v-.531A2.25 2.25 0 1 1 9.5 4.5v.53l4 2.286v3.256a2.25 2.25 0 1 1-1.5 0V8.372l-4-2.285v-.715A2.25 2.25 0 0 1 7 3.25" />
      </svg>
      <span class="repo-card__forks">0</span>
    </span>
  </footer>
</article>
