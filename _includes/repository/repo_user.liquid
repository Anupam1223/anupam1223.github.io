<div class="repo-user-card" data-username="{{ include.username }}">
  <div class="repo-user-card__header">
    <img class="repo-user-card__avatar" src="https://github.com/{{ include.username }}.png" alt="{{ include.username }}">
    <div class="repo-user-card__info">
      <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer" class="repo-user-card__name">
        {{ include.username }}
      </a>
      <p class="repo-user-card__bio">Loading...</p>
    </div>
  </div>
  <div class="repo-user-card__stats">
    <span class="repo-user-card__stat" title="Followers">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="currentColor">
        <path d="M2 5.5a3.5 3.5 0 1 1 5.898 2.549 5.507 5.507 0 0 1 3.034 4.084.75.75 0 1 1-1.482.235 4.001 4.001 0 0 0-7.9 0 .75.75 0 0 1-1.482-.236A5.507 5.507 0 0 1 3.102 8.05 3.49 3.49 0 0 1 2 5.5ZM11 4a3.001 3.001 0 0 1 2.22 5.018 5.01 5.01 0 0 1 2.56 3.012.75.75 0 0 1-1.499.07.25.25 0 0 0-.25-.25h-.5a.25.25 0 0 0-.25.25.75.75 0 0 1-1.5 0 2 2 0 0 0-1.5-2 .75.75 0 0 1-.75-.75V9.5a1 1 0 0 1 1-1H11a1 1 0 0 1 1 1v.5a.75.75 0 0 1-.75.75 2 2 0 0 0-1.5 2 .75.75 0 0 1-1.5 0 .25.25 0 0 0-.25-.25h-.5a.25.25 0 0 0-.25.25.75.75 0 0 1-1.5 0 5.01 5.01 0 0 1 2.56-3.012A3.001 3.001 0 0 1 11 4Z"></path>
      </svg>
      <span class="repo-user-card__followers">-</span>
    </span>
    <span class="repo-user-card__stat" title="Public Repos">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="currentColor">
        <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 1 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8a1 1 0 0 0 1-1Z"></path>
      </svg>
      <span class="repo-user-card__repos">-</span>
    </span>
  </div>
</div>
